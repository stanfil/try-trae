{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev"
      },
      {
        "name": "Next.js: debug server",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "env": {
          "NODE_OPTIONS": "--inspect"
        },
        "console": "integratedTerminal"
      }
    ]
  }